{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENGINE_TRIAL": "0",
        "EXPO_PUBLIC_MIXER_DIAGNOSTIC": "0"
      }
    },
    "engine-trial": {
      "extends": "staging",
      "env": {
        "EXPO_PUBLIC_ENGINE_TRIAL": "1"
      }
    },
    "mixer-diagnostic": {
      "extends": "staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_MIXER_DIAGNOSTIC": "1"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "nohjiyoung@hotmail.com",
        "bundleIdentifier": "com.tunesbasis.sorituh"
      }
    }
  }
}
