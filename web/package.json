{
  "name": "youtube-library-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "start:aws": "ng serve --host 127.0.0.1 --proxy-config proxy.aws.conf.json",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:effects": "node --test test/stem-effects.test.mjs",
    "test:accompaniment": "node --test test/accompaniment.test.mjs",
    "bundle:instruments": "node scripts/bundle-instruments.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "typescript": "~5.9.3"
  }
}
