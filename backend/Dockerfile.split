# Splits songs only: Demucs on the CPU and ffmpeg, without the analysis models of Dockerfile.stems, so the
# on-demand task pulls a much smaller image and starts sooner.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY split-requirements.txt .
RUN python3 -m venv /opt/stems \
    && /opt/stems/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/stems/bin/pip install --no-cache-dir torch==2.2.2+cpu torchaudio==2.2.2+cpu \
       --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
    && /opt/stems/bin/pip install --no-cache-dir -r split-requirements.txt
ENV STEM_PYTHON_PATH=/opt/stems/bin/python
ENV STEM_DEVICE=cpu
RUN /opt/stems/bin/python -c "from demucs.pretrained import get_model; get_model('htdemucs')"
COPY package*.json ./
RUN npm ci --omit=dev
COPY stem-worker.mjs stem-split-task.mjs stem-playback.mjs stem-shared.mjs stem-usage.mjs shared.mjs separate.py ./
CMD ["node", "stem-split-task.mjs"]
